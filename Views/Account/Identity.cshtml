@using MultiFactor.SelfService.Windows.Portal.Core
@using MultiFactor.SelfService.Windows.Portal.Services.API
@model MultiFactor.SelfService.Windows.Portal.Models.IdentityModel

@{
    ViewBag.Title = string.Format(Resources.Global.SiteName, Configuration.Current.CompanyName);
    var isCaptchaEnabled = Configuration.Current.RequireCaptchaOnLogin;
    if (isCaptchaEnabled)
    {
        ViewBag.RenderCaptchaScripts = true;
    }
}

<div action="#" class="login">
    <div class="form-column">
        <h2>@Resources.AccountLogin.Title</h2>
        @using (Html.BeginForm("Identity", "Account", new
        {
            samlSessionId = Context.Request.QueryString[MultiFactorClaims.SamlSessionId] ?? string.Empty,
            oidcSessionId = Context.Request.QueryString[MultiFactorClaims.OidcSessionId] ?? string.Empty
        }, FormMethod.Post, new { @class = "login-form" }))
        {
            <fieldset>
                @Html.AntiForgeryToken()
                <p>@Resources.AccountLogin.IdentityInvitation</p>
                <div class="form-row @(isCaptchaEnabled ? "mb-8" : "")">
                    <div class="input login-input login-input-username username-help-host">
                        <span>@Resources.AccountLogin.UserName</span>
                        @Html.TextBoxFor(m => m.UserName, new
                        {
                            placeholder = Configuration.Current.RequiresUpn
                                ? Resources.AccountLogin.UserNameUpn
                                : Resources.AccountLogin.UserName
                        })
                        @Html.Partial("_UsernameHelpTooltip")
                        @Html.ValidationMessageFor(m => m.UserName)
                    </div>
                    <div class="input">
                        <span>@Resources.AccountLogin.Password</span>
                        @Html.PasswordFor(m => m.Password, new { placeholder = Resources.AccountLogin.Password })
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>
                    @Html.ValidationSummary(true)
                    @if (isCaptchaEnabled)
                    {
                        <div class="captcha-wrapper login-captcha-wrapper">
                            @if (Configuration.Current.IsCaptchaEnabled(CaptchaType.Google))
                            {
                                <div class="g-recaptcha"
                                     data-sitekey="@Configuration.Current.CaptchaKey"
                                     data-callback="captchaCallback"
                                     data-size="normal">
                                </div>
                            }
                            @if (Configuration.Current.IsCaptchaEnabled(CaptchaType.Yandex))
                            {
                                <div id="yandex-captcha-container"></div>
                            }
                        </div>
                    }
                    @if (Configuration.Current.EnablePasswordRecovery && Configuration.Current.EnablePasswordManagement)
                    {
                        <div class="bottom-field-link-r pb-4">
                            <a href="@Url.Action("Index", "ForgottenPassword")">@Resources.AccountLogin.ResetPassword</a>
                        </div>
                    }
                </div>
                <div class="form-row">
                    <input type="hidden" name="myUrl" id="myUrl" />
                    @if (isCaptchaEnabled)
                    {
                        <input type="hidden" name="responseToken" id="responseToken" />
                        <input type="submit" class="btn-primary w-100" disabled="disabled" value="@Resources.AccountLogin.Next" id="next" />
                    }
                    else
                    {
                        <input type="submit" class="btn-primary w-100" value="@Resources.AccountLogin.Next" id="next" />
                    }
                </div>
            </fieldset>
        }
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        function enableSubmit() {
            $("form").find(':submit').removeAttr('disabled');
        }

        function captchaCallback(token) {
            $('#responseToken').val(token);
            enableSubmit();
        }

        $(document).ready(function () {
            $('#myUrl').val(document.location);
            $("form").submit(function () {
                if ($(this).valid()) {
                    $(this).find(':submit').attr('disabled', 'disabled').val('@Resources.AccountLogin.PleaseWait');
                }
            });
        });

        @if (Configuration.Current.IsCaptchaEnabled(CaptchaType.Yandex))
        {
            <text>
            function yandexCaptchaLoadFunction()
            {
                if (window.smartCaptcha)
                {
                    const container = document.getElementById('yandex-captcha-container');
                    window.smartCaptcha.render(container, {
                        sitekey: '@Configuration.Current.CaptchaKey',
                        callback: captchaCallback,
                        hl: '@LocalizationProvider.GetLanguage()'
                    });
                }
            }
            </text>
        }
    </script>
}
