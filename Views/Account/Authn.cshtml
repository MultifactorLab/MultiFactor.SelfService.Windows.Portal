@using MultiFactor.SelfService.Windows.Portal.Services.API
@model MultiFactor.SelfService.Windows.Portal.Models.IdentityModel

@{
    ViewBag.Title = string.Format(Resources.Global.SiteName, Configuration.Current.CompanyName);
}

<div action="#" class="login">
    <div class="form-column">
        <h2>@Resources.AccountLogin.Title</h2>
        @using (Html.BeginForm("Authn", "Account", new
        {
            samlSessionId = Context.Request.QueryString[MultiFactorClaims.SamlSessionId] ?? string.Empty,
            oidcSessionId = Context.Request.QueryString[MultiFactorClaims.OidcSessionId] ?? string.Empty
        }, FormMethod.Post, new { @class = "login-form" }))
        {
            <fieldset>
                @Html.AntiForgeryToken()
                <p>@Resources.AccountLogin.AuthnInvitation <b>@Model.UserName</b></p>
                <div class="form-row">
                    <div class="input login-input login-input-password">
                        <span>@Resources.AccountLogin.Password</span>
                        @Html.PasswordFor(m => m.Password, new { placeholder = Resources.AccountLogin.Password, autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>
                    @Html.HiddenFor(m => m.UserName)
                    @Html.HiddenFor(m => m.AccessToken)
                    @Html.ValidationSummary(true)
                    @if (Configuration.Current.EnablePasswordRecovery && Configuration.Current.EnablePasswordManagement)
                    {
                        <div class="bottom-field-link-r pb-4">
                            <a href="@Url.Action("Index", "ForgottenPassword")">@Resources.AccountLogin.ResetPassword</a>
                        </div>
                    }
                </div>
                <div class="form-row">
                    <input type="hidden" name="myUrl" id="myUrl" />
                    <input type="submit" class="btn-primary w-100" value="@Resources.AccountLogin.Next" id="next" />
                </div>
            </fieldset>
        }
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#myUrl').val(document.location);
            $("form").submit(function () {
                if ($(this).valid()) {
                    $(this).find(':submit').attr('disabled', 'disabled').val('@Resources.AccountLogin.PleaseWait');
                }
            });
        });
    </script>
}
