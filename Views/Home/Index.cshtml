@model MultiFactor.SelfService.Windows.Portal.ViewModels.ShowcaseViewModel

@{
    ViewBag.Title = string.Format(Resources.Global.SiteName, Configuration.Current.CompanyName);
}

<div class="login">
    <div class="form-column @(Configuration.Current.Links.Length > 0 ? "showcase-no-top-padding" : "") ">
        @if (Configuration.Current.NotifyOnPasswordExpirationDaysLeft > 0 && Model.Profile.PasswordExpirationDaysLeft <= Configuration.Current.NotifyOnPasswordExpirationDaysLeft)
        {
            <div class="alert">
                <h4>@Resources.Home.ShouldChangePassword</h4>
                <h5>@Resources.Home.PasswordExpirationDaysLeft: @Model.Profile.PasswordExpirationDaysLeft</h5>
            </div>
        }
         <div class="auth-details">
        @if (Model.ShowcaseLinks != null && Model.ShowcaseLinks.Count > 0)
        {
            <div class="showcase">
                @foreach (var link in Model.ShowcaseLinks)
                {
                    <a href="@link.Url" @(link.OpenInNewTab ? "target=_blank" : "")>
                        <div class="showcase-link">
                            <img class="showcase-link-image" src="~/@(string.IsNullOrWhiteSpace(link.Image) ? "content/images/ssoResource.svg" : ("content/images/showcase/" + link.Image))" />

                            <div class="link-title">
                                @link.Title
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        <div class="success-mark"></div>
        <h2 class="success-title">@Resources.Home.Title</h2>
        <div class="auth-username">
            <p>@Resources.Home.Greetings</p>
            <p class="user-login">@(Model.Profile.Name ?? Model.Profile.Identity)</p>
        </div>
    </div>

        <ul class="action">
            <li>
                @Html.ActionLink(Resources.Home.Configure2FA, "Index", "Configure2Fa", new { }, new { target = "_blank", @class = "btn btn-secondary" })
            </li>
            @if (Model.Profile.EnablePasswordManagement)
            {
                <li><a href="~/password/change" class="btn btn-secondary">@Resources.Home.ChangePassword</a></li>
            }
            @if (Model.Profile.EnableExchangeActiveSyncDevicesManagement)
            {
                <li><a href="~/ExchangeActiveSyncDevices" class="btn btn-secondary">@Resources.Home.ManageActiveSyncDevices</a></li>
            }
            <li><a href="~/account/logout" class="btn btn-secondary">@Resources.Home.Exit</a></li>
        </ul>
    </div>
</div>