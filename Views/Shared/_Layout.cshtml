@using System
@using Microsoft.Extensions.DependencyInjection
@using MultiFactor.SelfService.Windows.Portal.Core
@using MultiFactor.SelfService.Windows.Portal.Services.API
@{
    ViewBag.Title = ViewBag.Title ?? string.Format(Resources.Global.SiteName, Configuration.Current.CompanyName);

    var controller = ((string)ViewContext.RouteData.Values["controller"] ?? string.Empty).ToLowerInvariant();
    var action = ((string)ViewContext.RouteData.Values["action"] ?? string.Empty).ToLowerInvariant();

    var useAuthBackground =
        (controller == "account" && action == "login")
        || (controller == "forgottenpassword"
            && (action == "index" || action == "reset" || action == "done" || action == "wrong"));

    var isHome = controller == "home" && action == "index";
    var showcaseEnabled = false;
    if (isHome)
    {
        var showcaseOptions = HttpContext.Current.GetRequestServices()
            .GetService<global::MultiFactor.SelfService.Windows.Portal.Options.IShowcaseSettingsOptions>();
        if (showcaseOptions != null && showcaseOptions.CurrentValue != null)
        {
            showcaseEnabled = showcaseOptions.CurrentValue.Enabled;
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @RenderSection("head", false)
    <link rel="stylesheet" href="~/Content/style/site.css" />
    @if (ViewBag.RenderCaptchaScripts == true)
    {
        if (Configuration.Current.IsCaptchaEnabled(CaptchaType.Google))
        {
            <script src="https://www.google.com/recaptcha/api.js?hl=@LocalizationProvider.GetLanguage()" async defer></script>
        }
        if (Configuration.Current.IsCaptchaEnabled(CaptchaType.Yandex))
        {
            <script src="https://captcha-api.yandex.ru/captcha.js?render=onload&onload=yandexCaptchaLoadFunction" defer></script>
        }
    }
</head>
<body class="@(useAuthBackground ? "auth-form-background" : "")">
    <div id="wrapper">
        <div class="background-layout">
            <main id="main" class="@(isHome && showcaseEnabled ? "" : "content-center")">
                @RenderBody()
            </main>
            <footer id="footer">
                <img class="footer-icon" src="~/Content/images/footer.svg" alt="" />
            </footer>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/js/site.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
